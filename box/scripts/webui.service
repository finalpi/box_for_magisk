#!/system/bin/sh

control_box_dir="${BOX_DIR:-/data/adb/box}"
box_shell="${BOX_SHELL:-/system/bin/sh}"
settings_path="${control_box_dir}/settings.ini"
control_scripts_dir="${control_box_dir}/scripts"
control_run_dir="${control_box_dir}/run"

fail() { echo "$1" >&2; exit 1; }

[ -f "${settings_path}" ] || fail "settings.ini not found"
"${box_shell}" -n "${settings_path}" 2>/dev/null || fail "settings.ini contains a syntax error"
# shellcheck disable=SC1090
source "${settings_path}"

encode_value() { printf '%s' "$1" | busybox base64 | tr -d '\n'; }
emit() { printf '%s=%s\n' "$1" "$(encode_value "$2")"; }
decode_value() { printf '%s' "$1" | busybox base64 -d 2>/dev/null; }

replace_line() {
  key="$1"
  value="$2"
  temp="${control_run_dir}/settings.webui.$$"
  found="false"
  while IFS= read -r line || [ -n "${line}" ]; do
    case "${line}" in
      "${key}="*) printf '%s=%s\n' "${key}" "${value}"; found="true" ;;
      *) printf '%s\n' "${line}" ;;
    esac
  done < "${settings_path}" > "${temp}" || return 1
  [ "${found}" = "true" ] || printf '%s=%s\n' "${key}" "${value}" >> "${temp}"
  "${box_shell}" -n "${temp}" 2>/dev/null || { rm -f "${temp}"; return 1; }
  cat "${temp}" > "${settings_path}"
  rm -f "${temp}"
}

double_quote() {
  printf '%s' "$1" | busybox sed 's/\\/\\\\/g; s/"/\\"/g; s/\$/\\$/g; s/`/\\`/g'
}

read_status() {
  pid="$(busybox pidof "${bin_name}" 2>/dev/null | busybox awk '{print $1}')"
  running="false"
  uptime=""
  version=""
  [ -n "${pid}" ] && running="true"
  if [ -n "${pid}" ]; then
    uptime="$(busybox ps -o pid,etime 2>/dev/null | busybox awk -v pid="${pid}" '$1 == pid {print $2; exit}')"
    if [ "${bin_name}" = "clash" ]; then
      version="$(${bin_path} -v 2>/dev/null | head -n 1)"
    else
      version="$(${bin_path} version 2>/dev/null | head -n 1)"
    fi
  fi

  config_path=""
  case "${bin_name}" in
    clash) config_path="${clash_config}" ;;
    sing-box) config_path="${sing_config}" ;;
    xray) config_path="${xray_config}" ;;
    v2fly) config_path="${v2fly_config}" ;;
    hysteria) config_path="${hysteria_config}" ;;
  esac

  panel_url=""
  if [ "${bin_name}" = "clash" ] && [ -f "${clash_config}" ]; then
    controller="$(busybox awk '/^[[:space:]]*external-controller:/ {sub(/^[^:]*:[[:space:]]*/, ""); gsub(/"/, ""); print; exit}' "${clash_config}" | tr -d "'")"
    port="${controller##*:}"
    case "${port}" in ''|*[!0-9]*) ;; *) panel_url="http://127.0.0.1:${port}/ui/" ;; esac
  fi

  emit running "${running}"
  emit pid "${pid}"
  emit uptime "${uptime}"
  emit core "${bin_name}"
  emit mode "${network_mode}"
  emit version "${version}"
  emit config_path "${config_path}"
  emit panel_url "${panel_url}"
}

read_settings() {
  emit bin_name "${bin_name}"
  emit network_mode "${network_mode}"
  emit ipv6 "${ipv6}"
  emit renew "${renew}"
  emit update_subscription "${update_subscription}"
  emit run_crontab "${run_crontab}"
  emit custom_rules_subs "${custom_rules_subs}"
  urls=""
  for url in "${subscription_url_clash[@]}"; do
    [ -n "${urls}" ] && urls="${urls}
"
    urls="${urls}${url}"
  done
  emit subscription_urls "${urls}"
}

set_value() {
  key="$1"
  decoded="$(decode_value "$2")" || fail "invalid value encoding"
  case "${key}" in
    bin_name) case "${decoded}" in clash|sing-box|xray|v2fly|hysteria) ;; *) fail "unsupported core" ;; esac ;;
    network_mode) case "${decoded}" in tproxy|redirect|mixed|enhance|tun) ;; *) fail "unsupported network mode" ;; esac ;;
    ipv6|renew|update_subscription|run_crontab|custom_rules_subs) case "${decoded}" in true|false) ;; *) fail "boolean value required" ;; esac ;;
    *) fail "setting is not editable" ;;
  esac
  replace_line "${key}" "\"${decoded}\"" || fail "failed to update settings.ini"
  echo "Saved ${key}"
}

set_subscriptions() {
  encoded_list="$1"
  output="("
  old_ifs="${IFS}"
  IFS=','
  for encoded in ${encoded_list}; do
    [ -z "${encoded}" ] && continue
    url="$(decode_value "${encoded}")" || fail "invalid subscription encoding"
    case "${url}" in http://*|https://*) ;; *) fail "subscription URL must use http or https" ;; esac
    case "${url}" in *$'\n'*|*$'\r'*) fail "subscription URL contains a line break" ;; esac
    escaped="$(double_quote "${url}")"
    output="${output}\"${escaped}\" "
  done
  IFS="${old_ifs}"
  output="${output% })"
  [ "${output}" = "(" ] && output="()"
  replace_line "subscription_url_clash" "${output}" || fail "failed to update subscriptions"
  echo "Saved subscription URLs"
}

run_service_action() {
  case "$1" in
    start) "${control_scripts_dir}/box.service" start && "${control_scripts_dir}/box.iptables" enable ;;
    stop) "${control_scripts_dir}/box.iptables" disable; "${control_scripts_dir}/box.service" stop ;;
    restart) "${control_scripts_dir}/box.service" restart ;;
    subscription) "${control_scripts_dir}/box.tool" subs ;;
    *) fail "unsupported action" ;;
  esac
}

read_config() {
  case "${bin_name}" in
    clash) target="${clash_config}" ;;
    sing-box) target="${sing_config}" ;;
    xray) target="${xray_config}" ;;
    v2fly) target="${v2fly_config}" ;;
    hysteria) target="${hysteria_config}" ;;
    *) fail "unknown core" ;;
  esac
  [ -f "${target}" ] || fail "configuration file not found"
  cat "${target}"
}

case "$1" in
  status) read_status ;;
  settings) read_settings ;;
  set) set_value "$2" "$3" ;;
  set-subscriptions) set_subscriptions "$2" ;;
  start|stop|restart|subscription) run_service_action "$1" ;;
  config) read_config ;;
  logs) [ -f "${box_log}" ] && tail -n 240 "${box_log}" || echo "No runtime log found." ;;
  *) fail "Usage: $0 {status|settings|set|set-subscriptions|start|stop|restart|subscription|config|logs}" ;;
esac
